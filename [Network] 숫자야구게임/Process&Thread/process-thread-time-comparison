//process 코드

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>
#include <time.h>
#define COUNT 20

int main() {
	pid_t pid;
	struct timespec start, end;
	
	for(int t=1;t<=COUNT;t++){
		clock_gettime(CLOCK_MONOTONIC, &start);
		
		for(int i=0; i<t; i++) {
			pid = fork();	//자식 process 생성

			//process 생성 오류 시
			if (pid < 0) {
			    perror("fork failed");
			    exit(1);
			} else if (pid == 0) {		//자식 process
			    _exit(i);	
			} 
		}
		
		//자식 process 기라디기
		for(int i=0; i<t; i++){
			int status;	
			
			//waitpid로 자식 process 종료 상태 저장
			if(waitpid(-1,&status,0)==-1){
				perror("waitpid failed");	//오류 발생 시 처리
				exit(1);
			}
		}
		
		clock_gettime(CLOCK_MONOTONIC, &end);
	    	double runtime = (end.tv_sec - start.tv_sec) + (end.tv_nsec - start.tv_nsec)/1000000000.0;
	     	//결과 출력
	     	printf("total time[%d]: %.9f sec\n", t,runtime);
	}
	return 0;
}



//thread 코드
#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>
#include <time.h>
#define COUNT 20

void* thread_function(void* arg) {
    return NULL;
}

int main() {
    	pthread_t threads[20];
    	struct timespec start, end;
    	
    	for(int t=1;t<=COUNT;t++){
	    	clock_gettime(CLOCK_MONOTONIC, &start);
		    
	    	for (int i = 0; i < t; i++) {
	    		if(pthread_create(&threads[i], NULL, thread_function, NULL) != 0){
	    			perror("pthread create failed");
	    			exit(1);
	    		}
		}

	    	//thread_join
	    	for (int i = 0; i < t; i++) {
	        		if(pthread_join(threads[i], NULL) != 0){
	        			perror("clock_gettime end failed");
	        			exit(1);
	        		}
	    	}
	     	
	     	clock_gettime(CLOCK_MONOTONIC, &end);
	     	
	     	double runtime = (end.tv_sec - start.tv_sec) + (end.tv_nsec - start.tv_nsec)/1000000000.0;
	     	//결과 출력
	     	printf("total time[%d]: %.9f sec\n", t, runtime);
     	}
     	
	return 0;
}


